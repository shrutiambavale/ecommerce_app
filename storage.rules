rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function isUnderSize(maxSizeMB) {
      return request.resource.size < maxSizeMB * 1024 * 1024;
    }

    // 1. Product Images
    match /product_images/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() && isImage() && isUnderSize(10);
    }

    // 2. UPI Payment QR Images
    match /payment_qr/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() && isImage() && isUnderSize(10);
    }

    // 3. Customer Payment Receipts & Screenshots
    match /payment_receipts/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isImage() && isUnderSize(15);
    }
  }
}
